# ==============================================================================
# GroceReal Environment Configuration
# ==============================================================================

# Supabase PostgreSQL Connection Strings
# Replace [YOUR-PASSWORD] and [YOUR-PROJECT-REF] with your Supabase credentials:
# 1. DATABASE_URL: Transaction pooler (Port 6543) with pgbouncer=true for queries
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Direct session connection (Port 5432) for Prisma migrations
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# JWT Secret for NestJS API authentication
JWT_SECRET="grocereal_super_secret_jwt_key_change_in_production"
JWT_EXPIRES_IN="7d"

# NestJS API Port
PORT=3001

# Next.js Public API Base URL
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
